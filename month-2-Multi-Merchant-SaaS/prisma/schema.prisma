datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 🏷️ ENUMS & ROLE DEFINITIONS
// ==========================================

// Platform-level role for controlling basic user access
enum Role {
  CUSTOMER // Standard buyer account with limited access
  SELLER   // Merchant account allowed to own/manage stores
  ADMIN    // Super-administrator account with full platform control
}

// Tenant-level role for permissions inside a single merchant store
enum StoreRole {
  OWNER
  MANAGER
  STAFF
}

// Order fulfillment and payment status levels
enum OrderStatus {
  PENDING   // Order created, awaiting payment
  PAID      // Payment processed successfully
  SHIPPED   // Items dispatched
  DELIVERED // Received by customer
  CANCELLED // Refunded or voided
}

// ==========================================
// 👤 USER MANAGEMENT & SECURITY
// ==========================================

// Core user authentication and credentials table
model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  password         String
  role             Role           @default(CUSTOMER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  profile          Profile?
  ownedStores      Store[]        @relation("StoreOwner")
  storeMemberships StoreMember[]
  reviews          Review[]       // Reviews written by this user
  cartItems        CartItem[]     // Active cart items across stores
  orders           Order[]        // Orders placed by this user
}

// Personal demographic and location metadata details for a user
model Profile {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  phone      String?
  avatarUrl  String?
  street     String
  city       String
  state      String?
  postalCode String
  country    String
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// 🏢 MULTI-TENANT MERCHANTS (STORES)
// ==========================================

// Tenant Store representing individual merchant shops
model Store {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique // Unique URL slug for store page (e.g. "nike-official")
  description String?
  ownerId     Int
  owner       User          @relation("StoreOwner", fields: [ownerId], references: [id])
  members     StoreMember[]
  products    Product[]
  categories  Category[]
  orders      Order[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Junction table linking users to stores with specific roles
model StoreMember {
  id        Int       @id @default(autoincrement())
  storeId   Int
  userId    Int
  role      StoreRole @default(STAFF)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([storeId, userId])
}

// ==========================================
// 📂 PRODUCT CATALOG & TAXONOMIES
// ==========================================

// Category model for organizing products, supporting nested structures
model Category {
  id          Int        @id @default(autoincrement())
  storeId     Int
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  
  // Self-referential 1:N relationship for nested subcategories
  parentId    Int?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("SubCategories")
  
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([storeId, slug]) // Slug must be unique within a single store
  @@unique([storeId, name]) // Category name must be unique within a single store
}

// Product model representing inventory items sold by a specific store
model Product {
  id          Int              @id @default(autoincrement())
  storeId     Int
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String
  price       Decimal
  stock       Int              @default(0)
  images      String[]
  
  categoryId  Int
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  reviews     Review[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  
  // Self-referential N:M relationship for related products / bundles
  relatedTo   RelatedProduct[] @relation("ProductOrigin")
  relatedFrom RelatedProduct[] @relation("ProductRelated")

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([storeId, slug]) // Product slug must be unique within the store
}

// Junction table mapping related product recommendations
model RelatedProduct {
  id             Int      @id @default(autoincrement())
  productId      Int
  relatedId      Int
  product        Product  @relation("ProductOrigin", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product  @relation("ProductRelated", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
}

// Product reviews left by buyers
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 🛒 SHOPPING CARTS & CHECKOUT ORDERS
// ==========================================

// Temporary active shopping cart item (junction table linking user and product)
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

// Order model representing a store checkout transaction
model Order {
  id          Int         @id @default(autoincrement())
  storeId     Int
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount Decimal
  status      OrderStatus @default(PENDING)
  orderItems  OrderItem[]
  
  // Store-scoped ordering sequence (e.g. Store 1 has orders #1, #2; Store 2 has #1, #2)
  orderNumber Int
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([storeId, orderNumber]) // Enforces unique sequence number per tenant store
}

// Explicit line items in an order invoice
model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int
  priceAtPurchase Decimal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
